# ==========================================
# CyberSentinel Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Optional - App falls back to high-performance in-memory persistence if MongoDB is not running)
MONGODB_URI=mongodb://localhost:27017/cybersentinel

# Security & Authentication
JWT_SECRET=cybersentinel_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRES_IN=7d
SESSION_SECRET=cybersentinel_session_secret_key_9921_production

# Optional Integrations (Defaults to local heuristic analysis when empty)
# Google Safe Browsing API Key (v4 or lookup API)
SAFE_BROWSING_API_KEY=

# VirusTotal API Key (v3)
VIRUSTOTAL_API_KEY=

# AI Provider for Advanced Message Analysis (e.g., Google Gemini API)
GEMINI_API_KEY=
